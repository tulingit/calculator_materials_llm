# --- LLM ---
# Ключ API. Получи у OpenAI (https://platform.openai.com) или у OpenRouter (https://openrouter.ai)
OPENAI_API_KEY=

# Базовый URL API. Для OpenAI оставь как есть.
# Для OpenRouter: https://openrouter.ai/api/v1
# Для локальной Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Модель. Дешёвая и умная — gpt-4o-mini.
OPENAI_MODEL=

# --- Сервер ---
HOST=0.0.0.0
PORT=8000

# --- Playwright ---
# true — браузер невидимый (для сервера). false — видно окно (для отладки).
HEADLESS=true

# Сколько секунд ждать ответа от tn.ru
TN_TIMEOUT_SEC=90